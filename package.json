{
  "name": "engineer-plan",
  "publisher": "rhyanz46",
  "repository": {
    "type": "git",
    "url": "https://github.com/Rhyanz46/todos-vscode"
  },
  "displayName": "Engineer Plan",
  "description": "Track and manage your daily tasks from go-routine backend",
  "version": "0.0.4",
  "engines": {
    "vscode": "^1.106.1"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:engineerPlanView",
    "onCommand:engineer-plan.refresh"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "engineerPlanContainer",
          "title": "Todo",
          "icon": "media/check.svg"
        }
      ]
    },
    "views": {
      "engineerPlanContainer": [
        {
          "id": "engineerPlanView",
          "name": "Tasks"
        }
      ]
    },
    "commands": [
      {
        "command": "engineer-plan.refresh",
        "title": "Refresh",
        "icon": "$(sync)"
      },
      {
        "command": "engineer-plan.openWebsite",
        "title": "Go Routine Website",
        "icon": "$(globe)"
      },
      {
        "command": "engineer-plan.copyTodos",
        "title": "Copy Todos",
        "icon": "$(copy)"
      },
      {
        "command": "engineer-plan.filterTags",
        "title": "Filter Tags",
        "icon": "$(filter)"
      },
      {
        "command": "engineer-plan.login",
        "title": "Login",
        "icon": "$(key)"
      },
      {
        "command": "engineer-plan.logout",
        "title": "Logout",
        "icon": "$(sign-out)"
      },
      {
        "command": "engineer-plan.create",
        "title": "Create Todo",
        "icon": "$(add)"
      },
      {
        "command": "engineer-plan.deleteTodo",
        "title": "Delete Todo",
        "icon": "$(trash)"
      },
      {
        "command": "engineer-plan.updateTodo",
        "title": "Update Todo",
        "icon": "$(edit)"
      },
      {
        "command": "engineer-plan.showTodo",
        "title": "Show Todo",
        "icon": "$(info)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "engineer-plan.refresh",
          "when": "view == engineerPlanView",
          "group": "navigation"
        },
        {
          "command": "engineer-plan.openWebsite",
          "when": "view == engineerPlanView",
          "group": "navigation@0"
        },
        {
          "command": "engineer-plan.copyTodos",
          "when": "view == engineerPlanView",
          "group": "navigation@0"
        },
        {
          "command": "engineer-plan.filterTags",
          "when": "view == engineerPlanView",
          "group": "navigation@0"
        },
        {
          "command": "engineer-plan.logout",
          "when": "view == engineerPlanView && engineerPlan.hasToken",
          "group": "navigation@1"
        },
        {
          "command": "engineer-plan.login",
          "when": "view == engineerPlanView && !engineerPlan.hasToken",
          "group": "navigation@1"
        },
        {
          "command": "engineer-plan.create",
          "when": "view == engineerPlanView && engineerPlan.hasToken",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "engineer-plan.deleteTodo",
          "when": "view == engineerPlanView",
          "group": "inline"
        },
        {
          "command": "engineer-plan.updateTodo",
          "when": "view == engineerPlanView",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "id": "engineer-plan",
      "title": "Engineer Plan",
      "properties": {
        "engineer-plan.apiBaseUrl": {
          "type": "string",
          "default": "https://go-routine.com/core",
          "description": "Base URL of the backend API for the Todo extension (e.g. https://example.com/api)"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "clean": "node -e \"const fs=require('fs');['out','dist'].forEach(p=>{try{fs.rmSync(p,{recursive:true,force:true});}catch{}});\"",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.106.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.46.3",
    "eslint": "^9.39.1",
    "typescript": "^5.9.3",
    "ts-loader": "^9.5.4",
    "webpack": "^5.102.1",
    "webpack-cli": "^6.0.1",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
